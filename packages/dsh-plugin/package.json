{
  "name": "@dsh-codex-bridge/dsh-plugin",
  "version": "0.2.0",
  "description": "Loopback Codex delegation bridge for official DeepSeek Harness Desktop 0.2.0-rc.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwndlct/dsh-codex-bridge.git",
    "directory": "packages/dsh-plugin"
  },
  "homepage": "https://github.com/bwndlct/dsh-codex-bridge#readme",
  "bugs": { "url": "https://github.com/bwndlct/dsh-codex-bridge/issues" },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "cordis.patch.yml", "locale", "README.md", "LICENSE"],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "node ../../scripts/build-package.mjs plugin",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@dsh-codex-bridge/protocol": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
